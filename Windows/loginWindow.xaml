<Window x:Class="ComputerServiceManager.loginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ComputerServiceManager"
        mc:Ignorable="d"
        Title="Авторизация" Height="160" Width="280" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="15">
        <DockPanel  Margin="5,0,5,10">
            <Label Content="Логин" Width="80" Height="25"/>
            <TextBox x:Name="txtLogin" Width="150" Height="23" HorizontalAlignment="Left"/>
        </DockPanel>
        <DockPanel Margin="5,0,5,10">
            <Label Content="Пароль" Width="80" Height="25"/>
            <PasswordBox x:Name="txtPassword" Width="150" Height="23" HorizontalAlignment="Left"/>
        </DockPanel>
        <Button x:Name="btnLogin" Content="Войти" Width="100" Height="25" Margin="5" Click="btnLogin_Click"/>
        <TextBlock x:Name="txtError" Foreground="Red" Margin="5,10,5,5" TextWrapping="Wrap"/>
    </StackPanel>
</Window>
