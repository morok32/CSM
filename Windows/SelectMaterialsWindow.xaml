<Window x:Class="ComputerServiceManager.Windows.SelectMaterialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ComputerServiceManager.Windows"
        mc:Ignorable="d"
        Title="SelectMaterialsWindow" Height="auto" Width="300">
    <StackPanel Margin="5">
        <StackPanel>
            <TabControl>
                <TabItem Header="Материалы" Height="auto">
                    <DataGrid
                        x:Name="dgSelectMaterials"
                        Height="120"
                        AutoGenerateColumns="False"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Наименование"/>
                            <DataGridTextColumn Header="Доступное количество"/>
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Выбрать"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Услуги" Height="auto">
                    <DataGrid
                        x:Name="dgSelectServices"
                        Height="120"
                        AutoGenerateColumns="False"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Наименование"/>
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Выбрать"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
            
            <GroupBox Header="Фильтры и поиск">
                <StackPanel>
                    <TextBox x:Name="SearchMaterialInDataBase" Margin="0,5"/>
                    <DockPanel>
                        <TextBlock Text="Тип материала" Margin="5,0"/>
                        <ComboBox x:Name="cmbxTypeMaterial"/>
                    </DockPanel>
                </StackPanel>
            </GroupBox>
            <DockPanel>
                <Button Content="Назад" Width="100" Height="20" Margin="0,5,0,0"/>
            </DockPanel>
        </StackPanel>
    </StackPanel>
</Window>
