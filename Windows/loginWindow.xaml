<Window x:Class="ComputerServiceManager.loginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ComputerServiceManager"
        mc:Ignorable="d"
        Title="Авторизация" Height="auto" Width="auto">
    <StackPanel>
        <DockPanel  Margin="5,0,5,0">
            <Label Content="Логин" Width="55" Height="25"/>
            <TextBox Width="100" Height="20" HorizontalAlignment="Left"/>
        </DockPanel>
        <DockPanel Margin="5,0,5,0">
            <Label Content="Пароль" Width="55" Height="25"/>
            <TextBox Width="100" Height="20" HorizontalAlignment="Left"/>
        </DockPanel>
        <Button Content="Войти" Width="100" Height="20" Margin="5"/>
    </StackPanel>
</Window>
