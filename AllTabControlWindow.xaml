<Window x:Class="ComputerServiceManager.AllTabControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ComputerServiceManager.Controls"
        Title="Сервисный Центр" Height="550" Width="800" MinHeight="550" MinWidth="800">
    <Grid>
        <TabControl Margin="10" SelectionChanged="TabControl_SelectionChanged">
            <TabItem Header="Заказы"  VerticalAlignment="Top">
                <!-- Просто вставляем наш контрол -->
                <controls:OrdersControl x:Name="OrdersControl"/>
            </TabItem>
            <TabItem Header="Материалы"  VerticalAlignment="Top">
                <controls:MaterialsControl x:Name="MaterialsControl"/>
            </TabItem>
            <TabItem Header="Услуги"  VerticalAlignment="Top">
                <controls:ServicesControl />
            </TabItem>
            <TabItem Header="Пользователи"  VerticalAlignment="Top">
                <controls:UsersControl />
            </TabItem>
        </TabControl>
    </Grid>
</Window>