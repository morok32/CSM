<UserControl x:Class="ComputerServiceManager.Controls.UsersControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             MinHeight="450" MinWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="300"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,10,5" Grid.Row="0">
            <Label Content="Поиск: " Margin="0,0,0,5"/>
            <TextBox x:Name="searchTextBox" Width="250" Height="20"/>
        </StackPanel>

        <DataGrid Grid.Row="1"
                  Margin="5"
                  x:Name="UsersDataGrid"
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding idПользователь}" Width="auto" MaxWidth="70"/>
                <DataGridTextColumn Header="ФИО" Binding="{Binding ФИО}" Width="*"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding Роль.Наименование}" Width="auto" MaxWidth="120"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding НомерТелефона}" Width="auto" MaxWidth="120"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="auto" MaxWidth="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="5">
            <GroupBox Header="Фильтры" Height="auto" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <StackPanel>
                        <TextBlock Text="ФИО: " Height="20" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                        <TextBlock Text="Роль: " Height="20" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBox x:Name="txtUserName" Width="200" Height="20" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbUserRole" SelectedValuePath="idРоль" 
                          DisplayMemberPath="Наименование" 
                          SelectionChanged="cmbUserRole_SelectionChanged" 
                          Width="120" Height="20" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Управление" Height="auto">
                <StackPanel>
                    <Button x:Name="buttonAdd" Content="Добавить" Click="buttonAdd_Click" Width="100" Height="20" Margin="5"/>
                    <Button x:Name="buttonEdit" Content="Изменить" Click="buttonEdit_Click" Width="100" Height="20" Margin="5"/>
                    <Button x:Name="buttonSave" Content="Сохранить" Click="buttonSave_Click" Width="100" Height="20" Margin="5" Visibility="Collapsed"/>
                    <Button x:Name="buttonDelete" Content="Удалить" Click="buttonDelete_Click" Width="100" Height="20" Margin="5"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </Grid>
</UserControl>