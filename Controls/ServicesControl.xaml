<UserControl x:Class="ComputerServiceManager.Controls.ServicesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             MinHeight="450" MinWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="300"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,10,5" Grid.Row="0">
            <Label Content="Поиск: " Margin="0,0,0,5"/>
            <TextBox x:Name="searchTextBox" Width="250" Height="20" Margin="0,0,5,0"/>
            <Button x:Name="buttonAdd" Content="Добавить" Click="AddButton_Click" Width="100" Height="20" Margin="5"/>
            <Button x:Name="buttonEdit" Content="Открыть" Click="StartEditButton_Click" Width="100" Height="20" Margin="5"/>
            <Button x:Name="buttonSave" Content="Сохранить" Click="SaveEditButton_Click" Width="100" Height="20" Margin="5" IsEnabled="False"/>
            <Button x:Name="buttonDelete" Content="Удалить" Click="DeleteButton_Click" Width="100" Height="20" Margin="5"/>
        </StackPanel>

        <TabControl Grid.Row="1" Margin="5">
            <TabItem x:Name="tabDataGridForServices" Header="Услуги">
                <DataGrid x:Name="ServicesDataGrid"
                          Margin="5"
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding idУслуга}" Width="auto" MaxWidth="70"/>
                        <DataGridTextColumn Header="Наименование" Binding="{Binding Наименование}" Width="*"/>
                        <DataGridTextColumn Header="Цена" Binding="{Binding Стоимость, StringFormat=C}" Width="auto" MaxWidth="100"/>
                        <DataGridTextColumn Header="Описание" Binding="{Binding Описание}" Width="auto" MaxWidth="200"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem x:Name="tabEditServices" Header="Редактирование">
                <StackPanel>
                    <TextBox x:Name="txtServiceName"/>
                    <TextBox x:Name="txtServicePrice"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>